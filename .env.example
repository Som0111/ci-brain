# Copy to .env for local runs. On Render, set these in the service's Environment tab instead.
# Names are case-insensitive. Only DATABASE_URL is needed to run; everything else has a default.

# --- required -----------------------------------------------------------------------------------
# SQLAlchemy URL of the PostgreSQL database. Render's plain postgresql://... URL also works.
DATABASE_URL=postgresql+psycopg2://ci_brain:ci_brain@localhost:5432/ci_brain

# --- optional features ---------------------------------------------------------------------------
# Google Gemini key for POST /repos/{id}/failure-clusters/summarize. Unset = that endpoint returns a
# per-cluster error instead of a summary.
GEMINI_API_KEY=
# Request timeout for each Gemini call, in seconds (default 15).
GEMINI_TIMEOUT_SECONDS=15

# --- security ------------------------------------------------------------------------------------
# Shared secret. When set, POST /repos, POST /repos/{id}/runs and the summarize endpoint require an
# X-API-Key header with this value; unset = those endpoints are open. Generate: openssl rand -hex 32
# (scripts/replay_harness.py sends it from the CI_BRAIN_API_KEY environment variable.)
API_KEY=
# Comma-separated browser origins allowed by CORS, e.g. https://dashboard.example.com. "*" = any
# (the default; acceptable while only the API is deployed). CORS is not authentication.
CORS_ORIGINS=*

# --- limits --------------------------------------------------------------------------------------
# Maximum size of each uploaded JUnit XML / coverage JSON file, in bytes (default 25000000) -> HTTP 413.
MAX_UPLOAD_BYTES=25000000
# Maximum test results stored from one JUnit upload (default 50000) -> HTTP 413.
MAX_RESULTS_PER_RUN=50000

# --- runtime -------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR (default INFO). DEBUG also adds tracebacks to error logs; avoid in production.
LOG_LEVEL=INFO
# Port the container listens on (default 8000). Render injects this itself; leave unset there.
# PORT=8000
